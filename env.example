# Set these as Environment Variables in Vercel (Project -> Settings -> Environment
# Variables). For local dev copy this to .env.local and fill it in.
# Never commit real values.
#
# No login on this build — the app is protected at the Vercel deployment level
# (Project -> Settings -> Deployment Protection -> Password) instead. There is no
# database: profile and prescription history live in the browser (lib/localStore.ts).

# --- required: transcription (Deepgram) ---
# Project API key with at least MEMBER permission — Member is required to call
# /v1/auth/grant, which is how the browser gets a short-lived token. This key is
# server-side only and must never reach the browser.
DEEPGRAM_API_KEY=

# --- required: prescription structuring (Anthropic) ---
# Server-side only. Set a monthly spend cap in the Anthropic console — with no login
# and no per-user auth, the global daily cap in lib/ratelimit.ts plus this console cap
# are the only things bounding cost on a shared URL.
ANTHROPIC_API_KEY=

# --- optional: speaker labeling (Deepgram diarization) ---
# Off by default. Diarization is a real per-minute cost with real accuracy risk in a
# busy, far-field clinic recording (see lib/deepgram.ts).
NEXT_PUBLIC_RXVOICE_DIARIZE=false

# --- optional: rate limiting (Upstash Redis) ---
# Free at https://upstash.com. Without these, lib/ratelimit.ts falls back to a
# per-instance in-memory limiter — fine for a single Vercel instance, less reliable
# once traffic spans multiple.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
